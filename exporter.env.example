# Copia in exporter.env e adatta. NON committare exporter.env con credenziali reali.
GESTIONALE_BASE=http://192.168.1.11:8073
GESTIONALE_AJAX_PATH=/realtime/selling_ajax_reload.jssp
GESTIONALE_AKCSV=0,1,5,9,7,3,4,8,16,6,22,23,24
GESTIONALE_TMIN1=5
GESTIONALE_TMIN2=20
GESTIONALE_USER=admin
GESTIONALE_PASS=12345
GESTIONALE_AUTH=basic
SCRAPE_TIMEOUT=8
EXPORTER_PORT=8000
# ogni quanti secondi l'exporter rilegge il gestionale (thread di background)
REFRESH_INTERVAL=10
