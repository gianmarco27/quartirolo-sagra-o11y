    {
      "id": 5,
      "type": "barchart",
      "title": "Salsiccia — consumo al minuto",
      "description": "Ritmo di vendita: pezzi di salsiccia consumati al minuto (differenza del totale ordinato rispetto al minuto precedente). Ogni barra = 1 minuto; una tacca sull'asse X ogni ~5 minuti. Asse temporale in ora reale, segue la finestra della dashboard.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "pezzi/min",
            "axisGridShow": true,
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xField": "Time",
        "showValue": "never",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 55,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sagra:consumo_1m:salsiccia or vector(0)",
          "legendFormat": "consumo/min"
        }
      ]
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Salsiccia — pezzi rimanenti",
      "description": "Scorta iniziale (SALSICCIA_MAX, in pezzi) meno il consumo aggregato: 1 pezzo per Grigliata Mista Carne + 1 pezzo per Salsiccia e Patatine. Verde = abbondante, giallo = in calo, rosso = quasi esaurito.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": %%SALSICCIA_MAX%%,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "%%SALSICCIA_MAX%% - ((sum(sagra_qt_totale{id=\"43\"}) or vector(0)) + (sum(sagra_qt_totale{id=\"44\"}) or vector(0)))",
          "legendFormat": "rimanenti",
          "instant": true
