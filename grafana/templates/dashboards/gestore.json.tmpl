    {
      "id": 1,
      "type": "gauge",
      "title": "Lasagne — porzioni rimanenti",
      "description": "Scorta iniziale (LASAGNE_MAX) meno il consumo aggregato (1 per Lasagne Tradizionali + 3/7 per Tris di pasta). Verde = abbondante, giallo = in calo, rosso = quasi esaurito.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": %%LASAGNE_MAX%%,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "%%LASAGNE_MAX%% - (sum(sagra_qt_totale{id=\"36\"}) + (3/7) * sum(sagra_qt_totale{id=\"37\"}))",
          "legendFormat": "rimanenti",
          "instant": true
        }
      ]
    },
