apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%TIGELLE_MAX%% e %%ALLERTA_TIGELLE_RIMANENTI%% vengono
# sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Secondi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-tigelle-rimanenti
        title: Tigelle in esaurimento
        condition: C
        # A = tigelle consumate (aggregato BOM, live): 1 per ciascun piatto
        #     Tigella vuota + Tigella CRUDO + Tigella COTTO + Tigella SALAME
        # B = tigelle rimanenti = TIGELLE_MAX - A
        # C = allerta se rimanenti < ALLERTA_TIGELLE_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: 'sum(sagra_qt_totale{id="58"}) + sum(sagra_qt_totale{id="59"}) + sum(sagra_qt_totale{id="60"}) + sum(sagra_qt_totale{id="176"})'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%TIGELLE_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_TIGELLE_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: secondi
          severita: warning
        annotations:
          __dashboardUid__: sagra-secondi
          __panelId__: "4"
          summary: 'Tigelle in esaurimento: restano meno di %%ALLERTA_TIGELLE_RIMANENTI%% tigelle (scorta iniziale %%TIGELLE_MAX%%).'
