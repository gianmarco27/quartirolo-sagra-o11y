apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%GNOCCO_FRITTO_MAX%% e %%ALLERTA_GNOCCO_FRITTO_RIMANENTI%%
# vengono sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Gestore
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-gnocco-fritto-rimanenti
        title: Gnocco fritto in esaurimento
        condition: C
        # A = gnocchi consumati (aggregato BOM, live): 1 pezzo per Gnocco Fritto (1pz),
        #     2 pezzi ciascuno per Gnocco con CRUDO / con COTTO / con SALAME
        # B = gnocchi rimanenti = GNOCCO_FRITTO_MAX - A
        # C = allerta se rimanenti < ALLERTA_GNOCCO_FRITTO_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: '(sum(sagra_qt_totale{id="53"}) or vector(0)) + 2 * (sum(sagra_qt_totale{id="54"}) or vector(0)) + 2 * (sum(sagra_qt_totale{id="55"}) or vector(0)) + 2 * (sum(sagra_qt_totale{id="56"}) or vector(0))'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%GNOCCO_FRITTO_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_GNOCCO_FRITTO_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: gestore
          severita: warning
        annotations:
          __dashboardUid__: sagra-gestore
          __panelId__: "10"
          summary: 'Gnocco fritto in esaurimento: restano meno di %%ALLERTA_GNOCCO_FRITTO_RIMANENTI%% pezzi (scorta iniziale %%GNOCCO_FRITTO_MAX%%).'
