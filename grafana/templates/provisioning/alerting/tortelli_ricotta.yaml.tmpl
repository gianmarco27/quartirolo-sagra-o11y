apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%TORTELLI_RICOTTA_MAX%% e %%ALLERTA_TORTELLI_RICOTTA_RIMANENTI%%
# vengono sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Primi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-tortelli-ricotta-rimanenti
        title: Tortelli ricotta in esaurimento
        condition: C
        # A = pezzi di tortelli ricotta consumati (aggregato BOM, live):
        #     8 per Tortelli alla Ricotta + 3 per ciascun tris (Burro, Ragu, di pasta)
        # B = pezzi rimanenti = TORTELLI_RICOTTA_MAX - A
        # C = allerta se rimanenti < ALLERTA_TORTELLI_RICOTTA_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: '8 * (sum(sagra_qt_totale{id="409"}) or vector(0)) + 3 * (sum(sagra_qt_totale{id="416"}) or vector(0)) + 3 * (sum(sagra_qt_totale{id="441"}) or vector(0)) + 3 * (sum(sagra_qt_totale{id="37"}) or vector(0))'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%TORTELLI_RICOTTA_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_TORTELLI_RICOTTA_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: primi
          severita: warning
        annotations:
          __dashboardUid__: sagra-primi
          __panelId__: "2"
          summary: 'Tortelli ricotta in esaurimento: restano meno di %%ALLERTA_TORTELLI_RICOTTA_RIMANENTI%% pezzi (scorta iniziale %%TORTELLI_RICOTTA_MAX%%).'
