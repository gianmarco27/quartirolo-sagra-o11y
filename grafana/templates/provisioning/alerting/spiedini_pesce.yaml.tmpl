apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%SPIEDINI_PESCE_MAX%% e %%ALLERTA_SPIEDINI_PESCE_RIMANENTI%%
# vengono sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Secondi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-spiedini-pesce-rimanenti
        title: Spiedini di pesce in esaurimento
        condition: C
        # A = unità di spiedini consumate (aggregato BOM, live): 3 per piatto Spiedini di Pesce 3Pz
        # B = unità rimanenti = SPIEDINI_PESCE_MAX - A
        # C = allerta se rimanenti < ALLERTA_SPIEDINI_PESCE_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: '3 * sum(sagra_qt_totale{id="411"})'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%SPIEDINI_PESCE_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_SPIEDINI_PESCE_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: secondi
          severita: warning
        annotations:
          __dashboardUid__: sagra-secondi
          __panelId__: "2"
          summary: 'Spiedini di pesce in esaurimento: restano meno di %%ALLERTA_SPIEDINI_PESCE_RIMANENTI%% unità (scorta iniziale %%SPIEDINI_PESCE_MAX%%).'
