apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%FRITTO_MISTO_MAX%% e %%ALLERTA_FRITTO_MISTO_RIMANENTI%% vengono
# sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Secondi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-fritto-misto-rimanenti
        title: Fritto misto in esaurimento
        condition: C
        # Unità di misura: CARTONI (1 cartone = 13 piatti Fritto Misto Mare).
        # A = cartoni consumati (live) = qt(Fritto Misto Mare) / 13
        # B = cartoni rimanenti = FRITTO_MISTO_MAX - A
        # C = allerta se rimanenti < ALLERTA_FRITTO_MISTO_RIMANENTI (es. 2 cartoni)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: 'sum(sagra_qt_totale{id="42"}) / 13'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%FRITTO_MISTO_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_FRITTO_MISTO_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: secondi
          severita: warning
        annotations:
          summary: 'Fritto misto in esaurimento: restano meno di %%ALLERTA_FRITTO_MISTO_RIMANENTI%% cartoni (scorta iniziale %%FRITTO_MISTO_MAX%% cartoni, 1 cartone = 13 piatti).'
