apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%LASAGNE_MAX%% e %%ALLERTA_LASAGNE_RIMANENTI%% vengono
# sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Primi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-lasagne-rimanenti
        title: Lasagne in esaurimento
        condition: C
        # A = porzioni di lasagne consumate (aggregato BOM, live)
        # B = porzioni rimanenti = LASAGNE_MAX - A
        # C = allerta se rimanenti < ALLERTA_LASAGNE_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: '(sum(sagra_qt_totale{id="36"}) or vector(0)) + (3/7) * (sum(sagra_qt_totale{id="37"}) or vector(0))'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%LASAGNE_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_LASAGNE_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: primi
          severita: warning
        annotations:
          __dashboardUid__: sagra-primi
          __panelId__: "1"
          summary: 'Lasagne in esaurimento: restano meno di %%ALLERTA_LASAGNE_RIMANENTI%% porzioni (scorta iniziale %%LASAGNE_MAX%%).'
