apiVersion: 1

# Generato da tools/render.py a partire da questo .tmpl + limits.env.
# I segnaposto %%SALSICCIA_MAX%% e %%ALLERTA_SALSICCIA_RIMANENTI%% vengono
# sostituiti con i valori di limits.env. NON modificare il file .yaml
# generato: modifica limits.env e rilancia `make render` (o `make up`).

groups:
  - orgId: 1
    name: Secondi
    folder: Sagra
    interval: 1m
    rules:
      - uid: sagra-salsiccia-rimanenti
        title: Salsiccia in esaurimento
        condition: C
        # A = pezzi di salsiccia consumati (aggregato BOM, live):
        #     1 per Grigliata Mista Carne + 1 per Salsiccia e Patatine
        # B = pezzi rimanenti = SALSICCIA_MAX - A
        # C = allerta se rimanenti < ALLERTA_SALSICCIA_RIMANENTI (preventiva)
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              instant: true
              range: false
              expr: 'sum(sagra_qt_totale{id="43"}) + sum(sagra_qt_totale{id="44"})'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: math
              datasource:
                type: __expr__
                uid: __expr__
              expression: '%%SALSICCIA_MAX%% - $A'
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: lt
                    params: [%%ALLERTA_SALSICCIA_RIMANENTI%%]
        noDataState: OK
        execErrState: Error
        for: 0m
        labels:
          categoria: secondi
          severita: warning
        annotations:
          __dashboardUid__: sagra-secondi
          __panelId__: "1"
          summary: 'Salsiccia in esaurimento: restano meno di %%ALLERTA_SALSICCIA_RIMANENTI%% pezzi (scorta iniziale %%SALSICCIA_MAX%%).'
