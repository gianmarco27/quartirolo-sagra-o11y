# limits.env — limiti di alert, modificabili ogni giorno (es. ri-rifornimento mattutino).
#
# Per ogni segnale/ingrediente:
#   <NOME>_MAX               = scorta iniziale disponibile
#   ALLERTA_<NOME>_RIMANENTI = soglia preventiva: allerta quando i rimanenti scendono sotto
#
# Interpolati nei template Grafana (grafana/templates/**) da `make render`
# (tools/render.py) usando i segnaposto %%NOME%%. Dopo la modifica: `make up`.

# --- Lasagne (porzioni) ---
LASAGNE_MAX=300
ALLERTA_LASAGNE_RIMANENTI=50

# --- Tortelli ricotta / verdi (pezzi; 1 porzione = 8 pezzi) ---
TORTELLI_RICOTTA_MAX=1600
ALLERTA_TORTELLI_RICOTTA_RIMANENTI=200

# --- Tortelli zucca (pezzi; 1 porzione = 8 pezzi) ---
TORTELLI_ZUCCA_MAX=1600
ALLERTA_TORTELLI_ZUCCA_RIMANENTI=200

# --- Tortelli speck (pezzi; 1 porzione = 8 pezzi) ---
TORTELLI_SPECK_MAX=1600
ALLERTA_TORTELLI_SPECK_RIMANENTI=200

# --- Salsiccia (pezzi) [secondi] ---
SALSICCIA_MAX=500
ALLERTA_SALSICCIA_RIMANENTI=60

# --- Spiedini di pesce (unità; 3 per piatto) [secondi] ---
SPIEDINI_PESCE_MAX=300
ALLERTA_SPIEDINI_PESCE_RIMANENTI=45

# --- Fritto misto (cartoni; 1 cartone = 13 piatti) [secondi] ---
FRITTO_MISTO_MAX=20
ALLERTA_FRITTO_MISTO_RIMANENTI=2

# --- Tigelle (unità; 1 per piatto) [secondi] ---
TIGELLE_MAX=1000
ALLERTA_TIGELLE_RIMANENTI=50

# --- Gnocco fritto (pezzi; 1 per Gnocco Fritto, 2 per Gnocco con CRUDO/COTTO/SALAME) [gestore] ---
GNOCCO_FRITTO_MAX=1000
ALLERTA_GNOCCO_FRITTO_RIMANENTI=100
